# Ma'lumotlar bazasi
# SQLite (standart, sinov uchun):
DATABASE_URL=sqlite:///./optom_market.db
# Production uchun PostgreSQL misoli:
# DATABASE_URL=postgresql://user:password@localhost:5432/optom_market

# JWT sozlamalari — PRODUCTIONDA ALBATTA O'ZGARTIRING!
SECRET_KEY=CHANGE_THIS_SECRET_KEY_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Admin panel sessiya kaliti — PRODUCTIONDA ALBATTA O'ZGARTIRING!
ADMIN_SECRET_KEY=CHANGE_THIS_ADMIN_SESSION_KEY_IN_PRODUCTION

CORS_ORIGINS=*
